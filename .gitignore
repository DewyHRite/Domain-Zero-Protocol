# Domain Zero Protocol - Privacy & State Management
# This file ensures sensitive information stays local and never reaches version control

# ============================================================================
# PRIVATE INTELLIGENCE (NEVER COMMIT)
# ============================================================================

# Trigger 19 Intelligence - Contains private work session data
.protocol-state/trigger-19.md

# ============================================================================
# AUTHORIZATION PROTOCOL (v8.5.1+) - NEVER COMMIT
# ============================================================================

# Session state and authorization logs (security-sensitive, local only)
.protocol-state/authorization/session-state.json
.protocol-state/authorization/authorization.log

# Custom agent security (v8.7.0+) - Runtime data, never commit
.protocol-state/custom-agent-registry.json
.protocol-state/authorization/custom-agent-audit.log

# File integrity monitoring (v8.8.0+) - Audit log, lockfiles, and test files
.protocol-state/security/integrity-audit.log
.protocol-state/security/file-integrity.json.lock
.protocol-state/security/*.lock
.protocol-state/security/*.test.json
.protocol-state/security/*.test.log

# ============================================================================
# RESEARCH MODE RAW NOTES (v7.2.0+) - NEVER COMMIT
# ============================================================================

# Raw research logs (privacy-protected, gitignored per RESEARCH_MODE.md)
.protocol-state/research/**/*.raw.log
.protocol-state/research/**/raw.log

# Research scratch notes and temporary files
.protocol-state/research/**/*.tmp
.protocol-state/research/**/*.temp

# ============================================================================
# BACKUPS (KEEP LOCAL ONLY)
# ============================================================================

# Backup files created by system update or manual saves
.protocol-state/backups/
*.backup
*.backup.*
*_backup.*

# Snapshots (v8.8.0+ - user-specific state checkpoints)
.protocol-state/snapshots/
*.snapshot.json
*.snapshot.json.gz

# Versioned folder backups (OLD SYSTEM - keep external)
Domain Zero Protocol Backups/
Domain Zero Protocol v*/

