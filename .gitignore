# Domain Zero Protocol - per-install privacy (distro template)
# Shipped as the published repo's .gitignore so fresh installs keep local data local.
.protocol-state/trigger-19.md
.protocol-state/authorization/session-state.json
.protocol-state/authorization/authorization.log
.protocol-state/custom-agent-registry.json
.protocol-state/security/*.lock
.protocol-state/research/**/*.raw.log
.protocol-state/backups/
*.backup
*.backup.*
.dzp-killswitch/
.protocol-state/brain/brain.db
.protocol-state/brain/cortex-snapshot.md
__pycache__/
*.pyc

# SEC-BRAIN-007: additional brain-directory backstop entries (2026-06-14)
.protocol-state/brain/memories/
.protocol-state/brain/model-cache/
.protocol-state/brain/index.log
.protocol-state/brain/index.lock

# v9.2.0 Script Orchestration — DEV-ONLY (USER decision: must NOT ship to distro)
dzp.py
.protocol-state/script_coordinator.py
.protocol-state/script_dependencies.yaml

# FEAT-IDGOV-001 (v9.10.0, Phase G4/G5): per-wrapper signing secrets and the
# registry lockfile are LOCAL, per-install runtime artifacts, never committed
# by a consumer install either. The real issue-registry.jsonl itself is NOT
# ignored here -- once a consumer activates issue governance it becomes their
# own append-only committed audit ledger, same as the two protected records.
.protocol-state/.idgov-tokens/
*.jsonl.lock

# BUG-CORTEX-008 R5 (v9.10.0, Megumi Tier-3 P2-2): detached Cortex step
# output (script_coordinator.py `detach: true` mode) writes a rolling
# diagnostic log here; local runtime artifact, never committed.
.protocol-state/logs/
