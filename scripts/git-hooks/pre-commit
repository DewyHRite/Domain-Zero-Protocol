#!/bin/sh
# Domain Zero Protocol - Unified Pre-commit Hook (FEAT-GUARD-001, v9.9.5)
# Combines: protected-records secret scan + publish-branch skip + append-only guard
#           + agent/protected-file guard + validate-protocol.py state validation.
#
# Run order:
#   1. Secret scan           (SEC-001: protected records always scanned for secrets —
#                              runs BEFORE the publish-branch skip so DZP-v*/release
#                              branches are scanned too, see step 2's comment)
#   2. Publish-branch skip   (DZP-v* / release branches bypass the REMAINING dev-state
#                              checks below, but NOT the secret scan above)
#   3. Append-only guard     (FEAT-GUARD-001: protected docs must only grow)
#   4. Agent/file guard      (FEAT-REQ-001: Cross-Agent Edit Restrictions)
#   5. Protocol validation   (validate-protocol.py --check)
#
# Install via: scripts/install-git-hooks.sh  (or .ps1 on Windows/PowerShell)
# Sanctioned overrides are printed on block.
#
# DZP_ALLOW_PROTOCOL_EDIT=1 (v9.9.5+): scoped override for stage 4 ONLY (the
# FEAT-REQ-001 protected-path guard). Mirrors DZP_ALLOW_PROTECTED_REWRITE
# (stage 3's override) so a Gojo/USER-authorized protocol change can commit
# without `git commit --no-verify`, which dangerously skips EVERY stage
# (secret scan, append-only guard, AND validate-protocol.py). The two
# overrides are independent and composable: setting DZP_ALLOW_PROTOCOL_EDIT
# alone does NOT bypass stage 3 (append-only) or stage 5 (validate-protocol) —
# both still run and can still block the commit on their own terms.
#
# DZP_ALLOW_MISSING_SECRET_SCAN=1 (F9, v9.9.5+): a THIRD, independent,
# dedicated break-glass override -- for stage 1 ONLY, and ONLY the specific
# case where scripts/scan_protected_records.py itself cannot be found (e.g. a
# distro install published before the SEC-001 manifest fix). Stage 1 used to
# WARN then allow the commit through in that case, silently skipping a
# mandatory secret-scan gate. It now fails CLOSED by default; this override
# exists solely to consciously accept that specific gap and is never reused
# for, or conflated with, the other two overrides above.
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# ============================================================================
# 1. SEC-001: PROTECTED-RECORDS SECRET SCAN (compensates the GitHub
#    secret_scanning.yml file-wide path-ignore on dev-notes.md — see that file
#    and scripts/scan_protected_records.py for full rationale)
# ============================================================================
# CodeRabbit PR#108: intentionally runs BEFORE the publish-branch skip (step 2)
# below. DZP-v*/release branches are still real commits that dzp-publish
# produces from real content — the prior ordering let the branch-skip exit
# before this scan ever ran, so a secret staged on a publish branch was never
# caught by this gate at all. Everything else in this hook legitimately does
# not apply to publish branches (dev-state validation, append-only, agent/file
# guard); the secret scan is the one check that must still apply everywhere.
SECRET_SCAN="$ROOT/scripts/scan_protected_records.py"
if [ -f "$SECRET_SCAN" ]; then
    PYS=""
    if command -v python3 >/dev/null 2>&1; then PYS=python3
    elif command -v python >/dev/null 2>&1; then PYS=python
    fi
    if [ -n "$PYS" ]; then
        "$PYS" "$SECRET_SCAN" || exit 1
    else
        echo "[protected-secret-scan] WARNING: python not found — secret scan SKIPPED" >&2
    fi
else
    # F9 (CodeRabbit PR#109, P2): this branch previously WARNED then allowed
    # the commit through — a missing scanner (e.g. a distro install published
    # before the v9.9.5 manifest fix) silently skipped the ENTIRE mandatory
    # SEC-001 secret-scan gate, reporting commit success with the scan never
    # run. Now fails CLOSED by default, with a dedicated break-glass override
    # (DZP_ALLOW_MISSING_SECRET_SCAN, distinct from the other two overrides
    # in this hook) for an explicitly authorized exception.
    if [ "${DZP_ALLOW_MISSING_SECRET_SCAN:-}" = "1" ]; then
        echo "[protected-secret-scan] BYPASS: DZP_ALLOW_MISSING_SECRET_SCAN=1 — scanner not found, SEC-001 scan SKIPPED (authorized)." >&2
    else
        echo "[protected-secret-scan] COMMIT BLOCKED: scripts/scan_protected_records.py not found — mandatory SEC-001 secret scan cannot run." >&2
        echo "  Fix: restore the scanner or reinstall via scripts/install-git-hooks.(sh|ps1)." >&2
        echo "  Authorized exception: DZP_ALLOW_MISSING_SECRET_SCAN=1 git commit ..." >&2
        exit 1
    fi
fi

# ============================================================================
# 2. PUBLISH-BRANCH SKIP
# ============================================================================
# The 'release' / 'DZP-v*' branches are published distribution artifacts built
# by dzp-publish, NOT dev working trees. They intentionally exclude
# .protocol-state/ dev state, so the dev-state validator does not apply.
# dzp-publish already gates them (version + PII + path audits). The secret
# scan (step 1, above) already ran and is NOT bypassed by this early exit.
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
case "$CURRENT_BRANCH" in
  DZP-v[0-9]*|release)
    echo "Publish branch ($CURRENT_BRANCH, distro artifact) — skipping dev-state validation (gated by dzp-publish)."
    exit 0
    ;;
esac

# ============================================================================
# 3. FEAT-GUARD-001: PROJECT DOCUMENTS append-only enforcement
# ============================================================================
# dev-notes.md, security-review.md and domain.record.md are permanent project
# memory — the HEAD blob must remain a byte-prefix of the staged blob (pure
# append). Override a legit rewrite (rotation / authorized restore) with
# DZP_ALLOW_PROTECTED_REWRITE=1.
GUARD="$ROOT/scripts/check_protected_append_only.py"
if [ -f "$GUARD" ]; then
    PYG=""
    if command -v python3 >/dev/null 2>&1; then PYG=python3
    elif command -v python >/dev/null 2>&1; then PYG=python
    fi
    if [ -n "$PYG" ]; then
        "$PYG" "$GUARD" || exit 1
    else
        echo "[protected-guard] WARNING: python not found — append-only guard SKIPPED" >&2
    fi
fi

# ============================================================================
# 4. FEAT-REQ-001: AGENT / PROTECTED-FILE GUARD (Cross-Agent Edit Restrictions)
# ============================================================================
# Blocks `git commit` when staged changes touch DZP-protected paths outside a
# sanctioned agent session. Protected paths are read from protocol.config.yaml
# (fail-safe fallback list below if python/yaml unavailable).
CONFIG="$ROOT/protocol.config.yaml"

# Staged paths: Added/Copied/Modified/Renamed/Deleted. Check BOTH sides of
# renames/copies so renaming a protected source out (e.g. protocol/x.md ->
# docs/x.md) doesn't bypass the guard. Deletions (D) also blocked.
status=$(git diff --cached --name-status --find-renames --diff-filter=ACMRD || true)
[ -z "$status" ] && {
    # Nothing staged for the file-path guard — skip to protocol validation.
    :
}

if [ -n "$status" ]; then
    staged=$(printf '%s\n' "$status" | awk -F'\t' '{ for (i = 2; i <= NF; i++) if ($i != "") print $i }')

    if [ -n "$staged" ]; then
        # Fail-safe default protected list (used if python/yaml or config unavailable).
        DEFAULT_PATHS="protocol/
.claude/agents/
.protocol-state/custom-agent-registry.json
.protocol-state/authorization/
protocol.config.yaml"

        get_protected_paths() {
            PY=""
            if command -v python3 >/dev/null 2>&1; then PY=python3
            elif command -v python >/dev/null 2>&1; then PY=python
            fi
            if [ -n "$PY" ] && [ -f "$CONFIG" ]; then
                out=$("$PY" - "$CONFIG" <<'PYEOF'
import sys
try:
    import yaml
    cfg = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
    fp = ((cfg.get("custom_agent_security") or {}).get("file_protection") or {})
    paths = fp.get("immutable_paths") or []
    for p in paths:
        print(str(p).strip())
except Exception:
    sys.exit(7)
PYEOF
                ) && [ -n "$out" ] && { printf '%s\n' "$out"; return; }
            fi
            printf '%s\n' "$DEFAULT_PATHS"
        }

        # Strip CR (Windows python/print emits CRLF; a trailing \r breaks prefix matching).
        protected=$(get_protected_paths | tr -d '\r')
        staged=$(printf '%s' "$staged" | tr -d '\r')

        violations=""
        old_ifs=$IFS
        IFS='
'
        for f in $staged; do
            for p in $protected; do
                [ -z "$p" ] && continue
                case "$f" in
                    "$p"*) violations="${violations}  ${f}    (protected: ${p})
" ;;
                esac
            done
        done
        IFS=$old_ifs

        if [ -n "$violations" ]; then
            if [ "${DZP_ALLOW_PROTOCOL_EDIT:-}" = "1" ]; then
                # Scoped bypass for THIS stage only. Loud, unconditional, never
                # silent. Stage 3 (append-only) and stage 5 (validate-protocol)
                # below are NOT affected by this variable and still run.
                printf '\n' >&2
                printf '[protocol-guard] BYPASS: authorized protocol edit (DZP_ALLOW_PROTOCOL_EDIT=1) - FEAT-REQ-001 protected-path check skipped for this commit.\n' >&2
                printf 'Staged changes allowed through by this override:\n\n' >&2
                printf '%s\n' "$violations" >&2
                printf 'Append-only guard (stage 3) and validate-protocol.py (stage 5) remain ACTIVE and unaffected.\n' >&2
                printf '\n' >&2
            else
                printf '\n'
                printf '==================================================================\n'
                printf '  DZP PROTECTED-FILE COMMIT BLOCKED (Cross-Agent Edit Restrictions)\n'
                printf '==================================================================\n'
                printf 'Staged changes modify DZP-protected paths:\n\n'
                printf '%s\n' "$violations"
                printf 'These files are protected. Sanctioned ways to proceed:\n'
                printf '  1. Invoke Gojo (Mission Control) for an authorized protocol change.\n'
                printf '  2. Invoke Sukuna via Gojo for system / protocol updates.\n'
                printf '  3. Override intentionally:  git commit --no-verify\n'
                printf '  4. Override just this stage (keeps append-only + validation active): DZP_ALLOW_PROTOCOL_EDIT=1 git commit\n\n'
                printf 'Reference: protocol/CLAUDE.md  (Cross-Agent Edit Restrictions)\n\n'
                exit 1
            fi
        fi
    fi
fi

# ============================================================================
# 5. PROTOCOL STATE VALIDATION
# ============================================================================
# M3 (CodeRabbit PR#99): resolve the python interpreter ONCE before calling
# validate-protocol.py.  The prior pattern suppressed first-pass stderr with
# 2>/dev/null then fell back via || to `python`, which could replace a genuine
# validation FAILURE with a "python: not found" error and hide the real cause.
# NOTE: the append-only guard (stage 3) is intentionally best-effort / non-fatal
# when python is absent (it warns and skips). Protocol validation (this stage)
# is a GATE — missing python must block the commit (fail-CLOSED).
echo "Running Domain Zero Protocol validation..."

PYV=""
if command -v python3 >/dev/null 2>&1; then
    PYV=python3
elif command -v python >/dev/null 2>&1; then
    PYV=python
else
    echo "COMMIT BLOCKED: python runtime not found — protocol validation requires Python." >&2
    echo "Install Python 3 (https://python.org) or bypass intentionally with: git commit --no-verify" >&2
    exit 1
fi

"$PYV" "$ROOT/scripts/validate-protocol.py" --check

VALIDATION_EXIT=$?

if [ $VALIDATION_EXIT -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: Protocol validation failed"
    echo ""
    echo "State files have validation errors. Fix the issues above before committing."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "Protocol validation passed - proceeding with commit"
echo ""

exit 0
