#!/bin/sh
# Domain Zero Protocol - Unified Pre-commit Hook (FEAT-GUARD-001, v9.12.1)
# Combines: protected-records secret scan + publish-branch skip + append-only guard
#           + agent/protected-file guard + validate-protocol.py state validation
#           + issue-id registry gate (FEAT-IDGOV-001, Phase G1, INERT by default)
#           + Trigger 19-R public-edition sanitization gate (FEAT-TRIGGER19R-9.11.0-001).
#
# Run order:
#   1. Secret scan           (SEC-001: protected records always scanned for secrets —
#                              runs BEFORE the publish-branch skip so DZP-v*/release
#                              branches are scanned too, see step 2's comment)
#   2. Publish-branch skip   (DZP-v* / release branches bypass the REMAINING dev-state
#                              checks below, but NOT the secret scan above)
#   3. Append-only guard     (FEAT-GUARD-001: protected docs must only grow)
#   4. Agent/file guard      (FEAT-REQ-001: Cross-Agent Edit Restrictions)
#   5. Protocol validation   (validate-protocol.py --check)
#   6. Issue-id registry gate (FEAT-IDGOV-001: check_issue_ids.py — early
#                              feedback only; INERT while protocol.config.yaml
#                              issue_governance.enabled=false, see that gate's
#                              own docstring; the AUTHORITATIVE tier is CI --
#                              .github/workflows/idgov-gate.yml, Phase G2)
#   7. Trigger 19-R gate     (FEAT-TRIGGER19R-9.11.0-001: only runs when
#                              docs/DESIGN-DECISIONS.md is staged; checks the
#                              INDEX version; fail-closed EXCEPT for a
#                              deliberately-absent checker, see DESIGN-001
#                              note below, which loudly skips instead)
#
# Install via: scripts/install-git-hooks.sh  (or .ps1 on Windows/PowerShell)
# Sanctioned overrides are printed on block.
#
# DZP_ALLOW_PROTOCOL_EDIT=1 (v9.9.5+): scoped override for stage 4 ONLY (the
# FEAT-REQ-001 protected-path guard). Mirrors DZP_ALLOW_PROTECTED_REWRITE
# (stage 3's override) so a Gojo/USER-authorized protocol change can commit
# without `git commit --no-verify`, which dangerously skips EVERY stage
# (secret scan, append-only guard, AND validate-protocol.py). The two
# overrides are independent and composable: setting DZP_ALLOW_PROTOCOL_EDIT
# alone does NOT bypass stage 3 (append-only) or stage 5 (validate-protocol) —
# both still run and can still block the commit on their own terms.
#
# DZP_ALLOW_MISSING_SECRET_SCAN=1 (F9/F10, v9.9.5+): a THIRD, independent,
# dedicated break-glass override -- for stage 1 ONLY, covering BOTH ways the
# mandatory SEC-001 secret scan can fail to run: (F9) scripts/
# scan_protected_records.py itself cannot be found (e.g. a distro install
# published before the SEC-001 manifest fix), and (F10) no python3/python
# runtime is available to RUN that scanner even when the file is present.
# Both used to WARN then allow the commit through, silently skipping a
# mandatory secret-scan gate. Stage 1 now fails CLOSED by default in both
# cases; this ONE override exists solely to consciously accept either gap
# and is never reused for, or conflated with, the other two overrides above.
# (Stage 3's append-only guard intentionally remains best-effort/non-fatal
# when python is absent -- a separate, deliberately-unchanged design
# decision; stage 5's validate-protocol.py already fails closed on its own,
# unrelated terms when python is absent and is not affected by this override.)
#
# DZP_ALLOW_MISSING_APPEND_GUARD=1 (BUG-HOOK-SELF-DISARM-001, v9.9.6+): a
# FOURTH, independent, dedicated break-glass override -- for stage 3 ONLY,
# covering the guard FILE (scripts/check_protected_append_only.py) being
# absent (e.g. deleted via `git rm`, or a distro install missing it).
# Previously an absent guard file silently WARNED-then-passed (the `if [ -f
# "$GUARD" ]` branch had no `else`) -- the entire FEAT-GUARD-001 append-only
# check AND the SEC-TOJI-102 stub-existence tripwire vanished with zero
# warning or block, unlike stage 1 which F9/F10 already hardened to fail
# closed. Stage 3 now fails CLOSED by default when the guard file cannot be
# found. Deliberately its OWN override, never reused for, or conflated with,
# DZP_ALLOW_PROTECTED_REWRITE (which authorizes a legitimate REWRITE when the
# guard IS present and running) or DZP_ALLOW_PROTOCOL_EDIT (stage 4's
# protected-path override) or DZP_ALLOW_MISSING_SECRET_SCAN (stage 1's
# missing-dependency override) -- this is "the append-only guard file itself
# cannot be found," a distinct concern from all three.
#
# DZP_ALLOW_ISSUE_ID_OVERRIDE=1 (FEAT-IDGOV-001, v9.10.0+): a FIFTH,
# independent, dedicated break-glass override -- for stage 6's GENUINE
# REGISTRY VIOLATION path ONLY (the issue-id registry gate,
# scripts/check_issue_ids.py returning non-zero because it found a real
# append-only/E1-E6 violation). This is the SAME override name
# check_issue_ids.py itself already documents and implements internally (its
# own module docstring + main()) for a genuine registry violation (backfill /
# migration / authorized exception) -- this hook stage does not reimplement
# that bypass logic, it only runs the script and propagates its exit code.
# Never conflated with DZP_ALLOW_PROTECTED_REWRITE, DZP_ALLOW_PROTOCOL_EDIT,
# DZP_ALLOW_MISSING_SECRET_SCAN, or DZP_ALLOW_MISSING_APPEND_GUARD.
#
# DZP_ALLOW_MISSING_ISSUE_ID_GATE=1 (SEC-IDGOV-G-001, Megumi Phase G review,
# v9.10.0+): a SIXTH, independent, dedicated break-glass override -- for
# stage 6's DEPENDENCY-GAP path ONLY, covering the gate SCRIPT
# (scripts/check_issue_ids.py) being absent OR no python3/python runtime
# being available to run it. Earlier drafts of this stage reused
# DZP_ALLOW_ISSUE_ID_OVERRIDE for BOTH the genuine-violation path above AND
# this missing-gate fallback -- Megumi's Phase G review flagged that as the
# same conflation class BUG-HOOK-SELF-DISARM-001 closed for stage 3: an
# operator setting DZP_ALLOW_ISSUE_ID_OVERRIDE=1 to authorize a legitimate
# content override (e.g. a backfill) would unknowingly ALSO mask a
# broken/missing gate, since one flag covered two unrelated risk decisions.
# This dedicated override mirrors DZP_ALLOW_MISSING_APPEND_GUARD's split from
# DZP_ALLOW_PROTECTED_REWRITE exactly. Setting DZP_ALLOW_ISSUE_ID_OVERRIDE
# alone no longer bypasses the missing-gate branches -- only this override
# does. Never conflated with any of the other five overrides above.
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# ============================================================================
# 1. SEC-001: PROTECTED-RECORDS SECRET SCAN (compensates the GitHub
#    secret_scanning.yml file-wide path-ignore on dev-notes.md — see that file
#    and scripts/scan_protected_records.py for full rationale)
# ============================================================================
# CodeRabbit PR#108: intentionally runs BEFORE the publish-branch skip (step 2)
# below. DZP-v*/release branches are still real commits that dzp-publish
# produces from real content — the prior ordering let the branch-skip exit
# before this scan ever ran, so a secret staged on a publish branch was never
# caught by this gate at all. Everything else in this hook legitimately does
# not apply to publish branches (dev-state validation, append-only, agent/file
# guard); the secret scan is the one check that must still apply everywhere.
SECRET_SCAN="$ROOT/scripts/scan_protected_records.py"
if [ -f "$SECRET_SCAN" ]; then
    PYS=""
    if command -v python3 >/dev/null 2>&1; then PYS=python3
    elif command -v python >/dev/null 2>&1; then PYS=python
    fi
    if [ -n "$PYS" ]; then
        "$PYS" "$SECRET_SCAN" || exit 1
    else
        # F10 (CodeRabbit PR#109 round-2, P2): this branch previously WARNED
        # then allowed the commit through -- a missing Python runtime
        # silently skipped the mandatory SEC-001 secret scan, the same
        # fail-open class F9 closed for a missing scanner FILE. Reuses the
        # SAME DZP_ALLOW_MISSING_SECRET_SCAN override (no new env var --
        # both are "the mandatory SEC-001 scan cannot run"). Deliberately
        # scoped to THIS stage only: stage 3's append-only guard stays
        # best-effort when python is absent (unchanged), and stage 5's
        # validate-protocol.py already fails closed independently when
        # python is absent (its own message/remedy, not this override).
        if [ "${DZP_ALLOW_MISSING_SECRET_SCAN:-}" = "1" ]; then
            echo "[protected-secret-scan] BYPASS: DZP_ALLOW_MISSING_SECRET_SCAN=1 — Python runtime not found, SEC-001 scan SKIPPED (authorized)." >&2
        else
            echo "[protected-secret-scan] COMMIT BLOCKED: no Python runtime — mandatory SEC-001 secret scan cannot run." >&2
            echo "  Fix: install Python 3, or set DZP_ALLOW_MISSING_SECRET_SCAN=1 git commit ... to bypass (authorized)." >&2
            exit 1
        fi
    fi
else
    # F9 (CodeRabbit PR#109, P2): this branch previously WARNED then allowed
    # the commit through — a missing scanner (e.g. a distro install published
    # before the v9.9.5 manifest fix) silently skipped the ENTIRE mandatory
    # SEC-001 secret-scan gate, reporting commit success with the scan never
    # run. Now fails CLOSED by default, with a dedicated break-glass override
    # (DZP_ALLOW_MISSING_SECRET_SCAN, distinct from the other two overrides
    # in this hook) for an explicitly authorized exception.
    if [ "${DZP_ALLOW_MISSING_SECRET_SCAN:-}" = "1" ]; then
        echo "[protected-secret-scan] BYPASS: DZP_ALLOW_MISSING_SECRET_SCAN=1 — scanner not found, SEC-001 scan SKIPPED (authorized)." >&2
    else
        echo "[protected-secret-scan] COMMIT BLOCKED: scripts/scan_protected_records.py not found — mandatory SEC-001 secret scan cannot run." >&2
        echo "  Fix: restore the scanner or reinstall via scripts/install-git-hooks.(sh|ps1)." >&2
        echo "  Authorized exception: DZP_ALLOW_MISSING_SECRET_SCAN=1 git commit ..." >&2
        exit 1
    fi
fi

# ============================================================================
# 2. PUBLISH-BRANCH SKIP
# ============================================================================
# The 'release' / 'DZP-v*' branches are published distribution artifacts built
# by dzp-publish, NOT dev working trees. They intentionally exclude
# .protocol-state/ dev state, so the dev-state validator does not apply.
# dzp-publish already gates them (version + PII + path audits). The secret
# scan (step 1, above) already ran and is NOT bypassed by this early exit.
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
case "$CURRENT_BRANCH" in
  DZP-v[0-9]*|release)
    echo "Publish branch ($CURRENT_BRANCH, distro artifact) — skipping dev-state validation (gated by dzp-publish)."
    exit 0
    ;;
esac

# ============================================================================
# 3. FEAT-GUARD-001: PROJECT DOCUMENTS append-only enforcement
# ============================================================================
# dev-notes.md, security-review.md and domain.record.md are permanent project
# memory — the HEAD blob must remain a byte-prefix of the staged blob (pure
# append). Override a legit rewrite (rotation / authorized restore) with
# DZP_ALLOW_PROTECTED_REWRITE=1.
GUARD="$ROOT/scripts/check_protected_append_only.py"
if [ -f "$GUARD" ]; then
    PYG=""
    if command -v python3 >/dev/null 2>&1; then PYG=python3
    elif command -v python >/dev/null 2>&1; then PYG=python
    fi
    if [ -n "$PYG" ]; then
        "$PYG" "$GUARD" || exit 1
    else
        echo "[protected-guard] WARNING: python not found — append-only guard SKIPPED" >&2
    fi
else
    # BUG-HOOK-SELF-DISARM-001 (Sukuna Bug Hunt 2026-07-11, P1, gap 2): this
    # branch previously did not exist -- a missing guard file (e.g. `git rm
    # scripts/check_protected_append_only.py` staged in the SAME commit as a
    # protected-doc rewrite) silently skipped the ENTIRE FEAT-GUARD-001
    # append-only check (and the SEC-TOJI-102 stub tripwire it also
    # performs), with no warning and no block -- repro-confirmed: a 538-line
    # non-append rewrite of dev-notes.md landed with `git commit` exit 0.
    # Mirrors stage 1's F9 fail-closed structure exactly, with its OWN
    # dedicated break-glass override (see header comment for why this is not
    # DZP_ALLOW_PROTECTED_REWRITE/DZP_ALLOW_PROTOCOL_EDIT/
    # DZP_ALLOW_MISSING_SECRET_SCAN).
    if [ "${DZP_ALLOW_MISSING_APPEND_GUARD:-}" = "1" ]; then
        echo "[protected-guard] BYPASS: DZP_ALLOW_MISSING_APPEND_GUARD=1 — guard not found, FEAT-GUARD-001 append-only check SKIPPED (authorized)." >&2
    else
        echo "[protected-guard] COMMIT BLOCKED: scripts/check_protected_append_only.py not found — mandatory FEAT-GUARD-001 append-only guard cannot run." >&2
        echo "  Fix: restore the guard or reinstall via scripts/install-git-hooks.(sh|ps1)." >&2
        echo "  Authorized exception: DZP_ALLOW_MISSING_APPEND_GUARD=1 git commit ..." >&2
        exit 1
    fi
fi

# ============================================================================
# 4. FEAT-REQ-001: AGENT / PROTECTED-FILE GUARD (Cross-Agent Edit Restrictions)
# ============================================================================
# Blocks `git commit` when staged changes touch DZP-protected paths outside a
# sanctioned agent session. Protected paths are read from protocol.config.yaml
# (fail-safe fallback list below if python/yaml unavailable).
CONFIG="$ROOT/protocol.config.yaml"

# Staged paths: Added/Copied/Modified/Renamed/Deleted. Check BOTH sides of
# renames/copies so renaming a protected source out (e.g. protocol/x.md ->
# docs/x.md) doesn't bypass the guard. Deletions (D) also blocked.
status=$(git diff --cached --name-status --find-renames --diff-filter=ACMRD || true)
[ -z "$status" ] && {
    # Nothing staged for the file-path guard — skip to protocol validation.
    :
}

if [ -n "$status" ]; then
    staged=$(printf '%s\n' "$status" | awk -F'\t' '{ for (i = 2; i <= NF; i++) if ($i != "") print $i }')

    if [ -n "$staged" ]; then
        # Fail-safe default protected list (used if python/yaml or config unavailable).
        # BUG-HOOK-SELF-DISARM-001 residual (P3 fold-in): this fallback must
        # never be a WEAKER list than the config-driven path above -- it now
        # mirrors the same security-critical engine scripts added to
        # protocol.config.yaml immutable_paths, so a degraded (python/yaml
        # unavailable) run of this hook still protects them.
        # WP5b (Gojo-authorized, USER full-remediation directive, 2026-07-30):
        # CLAUDE.md added alongside the engine scripts below -- same rationale
        # (fallback must never be a WEAKER list than the config-driven path).
        # See protocol.config.yaml immutable_paths for the full matcher-
        # semantics writeup (prefix match; a bare filename entry needs no
        # trailing slash, matches only the root file, not protocol/CLAUDE.md
        # or nested docs/**/CLAUDE.md).
        DEFAULT_PATHS="protocol/
CLAUDE.md
.claude/agents/
.protocol-state/custom-agent-registry.json
.protocol-state/authorization/
protocol.config.yaml
scripts/git-hooks/
scripts/scan_protected_records.py
scripts/check_protected_append_only.py
scripts/validate-protocol.py
scripts/check_branch_record_isolation.py
scripts/distro/assert_version.py
scripts/distro/check_version_stamps.py
scripts/check_issue_ids.py
scripts/backfill_issue_registry.py
scripts/issue_id.py
scripts/idgov/grammar.py
scripts/idgov/registry.py
scripts/idgov/identity.py
scripts/idgov/engine.py
scripts/idgov/__init__.py
scripts/secid.sh
scripts/secid.ps1
scripts/residentid-sukuna.sh
scripts/residentid-sukuna.ps1
scripts/residentid-gojo.sh
scripts/residentid-gojo.ps1
scripts/residentid-yuuji.sh
scripts/residentid-yuuji.ps1
.protocol-state/script_coordinator.py
.protocol-state/script_dependencies.yaml"

        get_protected_paths() {
            PY=""
            if command -v python3 >/dev/null 2>&1; then PY=python3
            elif command -v python >/dev/null 2>&1; then PY=python
            fi
            if [ -n "$PY" ] && [ -f "$CONFIG" ]; then
                out=$("$PY" - "$CONFIG" <<'PYEOF'
import sys
try:
    import yaml
    cfg = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
    fp = ((cfg.get("custom_agent_security") or {}).get("file_protection") or {})
    paths = fp.get("immutable_paths") or []
    for p in paths:
        print(str(p).strip())
except Exception:
    sys.exit(7)
PYEOF
                ) && [ -n "$out" ] && { printf '%s\n' "$out"; return; }
            fi
            printf '%s\n' "$DEFAULT_PATHS"
        }

        # Strip CR (Windows python/print emits CRLF; a trailing \r breaks prefix matching).
        protected=$(get_protected_paths | tr -d '\r')
        staged=$(printf '%s' "$staged" | tr -d '\r')

        violations=""
        old_ifs=$IFS
        IFS='
'
        for f in $staged; do
            for p in $protected; do
                [ -z "$p" ] && continue
                case "$f" in
                    "$p"*) violations="${violations}  ${f}    (protected: ${p})
" ;;
                esac
            done
        done
        IFS=$old_ifs

        if [ -n "$violations" ]; then
            if [ "${DZP_ALLOW_PROTOCOL_EDIT:-}" = "1" ]; then
                # Scoped bypass for THIS stage only. Loud, unconditional, never
                # silent. Stage 3 (append-only) and stage 5 (validate-protocol)
                # below are NOT affected by this variable and still run.
                printf '\n' >&2
                printf '[protocol-guard] BYPASS: authorized protocol edit (DZP_ALLOW_PROTOCOL_EDIT=1) - FEAT-REQ-001 protected-path check skipped for this commit.\n' >&2
                printf 'Staged changes allowed through by this override:\n\n' >&2
                printf '%s\n' "$violations" >&2
                printf 'Append-only guard (stage 3) and validate-protocol.py (stage 5) remain ACTIVE and unaffected.\n' >&2
                printf '\n' >&2
            else
                printf '\n'
                printf '==================================================================\n'
                printf '  DZP PROTECTED-FILE COMMIT BLOCKED (Cross-Agent Edit Restrictions)\n'
                printf '==================================================================\n'
                printf 'Staged changes modify DZP-protected paths:\n\n'
                printf '%s\n' "$violations"
                printf 'These files are protected. Sanctioned ways to proceed:\n'
                printf '  1. Invoke Gojo (Mission Control) for an authorized protocol change.\n'
                printf '  2. Invoke Sukuna via Gojo for system / protocol updates.\n'
                printf '  3. Override intentionally:  git commit --no-verify\n'
                printf '  4. Override just this stage (keeps append-only + validation active): DZP_ALLOW_PROTOCOL_EDIT=1 git commit\n\n'
                printf 'Reference: CLAUDE.md (root)  (Cross-Agent Edit Restrictions)\n\n'
                exit 1
            fi
        fi
    fi
fi

# ============================================================================
# 5. PROTOCOL STATE VALIDATION
# ============================================================================
# M3 (CodeRabbit PR#99): resolve the python interpreter ONCE before calling
# validate-protocol.py.  The prior pattern suppressed first-pass stderr with
# 2>/dev/null then fell back via || to `python`, which could replace a genuine
# validation FAILURE with a "python: not found" error and hide the real cause.
# NOTE: the append-only guard (stage 3) is intentionally best-effort / non-fatal
# when python is absent (it warns and skips). Protocol validation (this stage)
# is a GATE — missing python must block the commit (fail-CLOSED).
echo "Running Domain Zero Protocol validation..."

PYV=""
if command -v python3 >/dev/null 2>&1; then
    PYV=python3
elif command -v python >/dev/null 2>&1; then
    PYV=python
else
    echo "COMMIT BLOCKED: python runtime not found — protocol validation requires Python." >&2
    echo "Install Python 3 (https://python.org) or bypass intentionally with: git commit --no-verify" >&2
    exit 1
fi

"$PYV" "$ROOT/scripts/validate-protocol.py" --check

VALIDATION_EXIT=$?

if [ $VALIDATION_EXIT -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: Protocol validation failed"
    echo ""
    echo "State files have validation errors. Fix the issues above before committing."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "Protocol validation passed - proceeding with commit"
echo ""

# ============================================================================
# 6. FEAT-IDGOV-001: ISSUE-ID REGISTRY GATE (Phase G1)
# ============================================================================
# check_issue_ids.py enforces the append-only issue-id registry invariants
# (registry append-only + content invariants via idgov.engine.validate() reuse
# + mint-before-cite + malformed-id hard block). This stage is EARLY FEEDBACK
# ONLY -- the authoritative tier is CI (.github/workflows/idgov-gate.yml,
# Phase G2), which diffs the full push/PR range, not just the staged index.
#
# INERT BY DESIGN: protocol.config.yaml issue_governance.enabled governs
# whether the gate actually checks anything -- when false (the shipped
# default while FEAT-IDGOV-001 is pending its own separate, deliberate,
# USER-gated go-live), check_issue_ids.py itself prints a loud
# "[idgov-gate] DISABLED via config" notice to stderr and exits 0 without
# running any check. This stage does NOT duplicate that enabled/disabled
# logic -- it always invokes the script and trusts the script's own
# config-driven no-op; the only things this stage itself decides are (a) what
# happens if the script or python cannot be found, and (b) propagating the
# script's exit code. A genuine registry violation's bypass
# (DZP_ALLOW_ISSUE_ID_OVERRIDE=1) is likewise handled entirely INSIDE
# check_issue_ids.py -- this stage does not reimplement it, it just runs the
# script with the caller's environment intact (git hooks inherit the parent
# shell's exported environment by default) and propagates the result.
IDGOV_GATE="$ROOT/scripts/check_issue_ids.py"
if [ -f "$IDGOV_GATE" ]; then
    PYI=""
    if command -v python3 >/dev/null 2>&1; then PYI=python3
    elif command -v python >/dev/null 2>&1; then PYI=python
    fi
    if [ -n "$PYI" ]; then
        "$PYI" "$IDGOV_GATE" || exit 1
    else
        # SEC-IDGOV-G-001 (Megumi Phase G review, P2): this branch is the
        # "python runtime not found" dependency-gap case -- distinct from a
        # genuine registry violation. Uses the dedicated
        # DZP_ALLOW_MISSING_ISSUE_ID_GATE override (NOT
        # DZP_ALLOW_ISSUE_ID_OVERRIDE -- see this stage's own header note
        # below for why reusing that var here was rejected).
        if [ "${DZP_ALLOW_MISSING_ISSUE_ID_GATE:-}" = "1" ]; then
            echo "[idgov-gate] BYPASS: DZP_ALLOW_MISSING_ISSUE_ID_GATE=1 — Python runtime not found, issue-id registry gate SKIPPED (authorized)." >&2
        else
            echo "[idgov-gate] COMMIT BLOCKED: no Python runtime — issue-id registry gate cannot run." >&2
            echo "  Fix: install Python 3, or set DZP_ALLOW_MISSING_ISSUE_ID_GATE=1 git commit ... to bypass (authorized)." >&2
            exit 1
        fi
    fi
else
    # SEC-IDGOV-G-001: the gate SCRIPT itself cannot be found. Same dedicated
    # override as the missing-python branch above; DZP_ALLOW_ISSUE_ID_OVERRIDE
    # (the genuine-violation override check_issue_ids.py implements
    # internally) intentionally does NOT gate this branch anymore.
    if [ "${DZP_ALLOW_MISSING_ISSUE_ID_GATE:-}" = "1" ]; then
        echo "[idgov-gate] BYPASS: DZP_ALLOW_MISSING_ISSUE_ID_GATE=1 — scripts/check_issue_ids.py not found, issue-id registry gate SKIPPED (authorized)." >&2
    else
        echo "[idgov-gate] COMMIT BLOCKED: scripts/check_issue_ids.py not found — mandatory issue-id registry gate cannot run." >&2
        echo "  Fix: restore the gate or reinstall via scripts/install-git-hooks.(sh|ps1)." >&2
        echo "  Authorized exception: DZP_ALLOW_MISSING_ISSUE_ID_GATE=1 git commit ..." >&2
        exit 1
    fi
fi

# ============================================================================
# 7. FEAT-TRIGGER19R-9.11.0-001: TRIGGER 19-R PUBLIC-EDITION SANITIZATION GATE
# ============================================================================
# docs/DESIGN-DECISIONS.md is the PUBLIC edition of the Sukuna
# decision-provenance report, sourced from records that include the untracked
# domain.record.md. It may never be committed unsanitized. Checks the INDEX
# version (git show :path), the same staged-read convention stage 3's
# append-only guard uses -- not the working-tree copy, which could differ from
# what actually gets committed. Fail-closed: if the file is staged and the
# checker script cannot be found, the commit is blocked. Deliberately NO new
# DZP_ALLOW_* override here -- the break-glass is unstaging the file.
#
# --diff-filter=d excludes DELETED paths from the trigger (fix round 1,
# FINDING 1a): `git diff --cached --name-only` without a filter also lists a
# staged `git rm docs/DESIGN-DECISIONS.md`, and a deletion cannot leak
# content -- there is nothing to sanitize, and it must not be blocked. Without
# this filter, the unguarded `git show :docs/DESIGN-DECISIONS.md` below would
# exit 128 (no such path in the index) and, under `set -eu`, abort the WHOLE
# HOOK with a raw git fatal instead of this stage's branded message, leaking
# the mktemp file in the process.
if git diff --cached --name-only --diff-filter=d | grep -qx "docs/DESIGN-DECISIONS.md"; then
    T19R_CHECKER="$ROOT/scripts/check_trigger19r_sanitization.py"
    if [ ! -f "$T19R_CHECKER" ]; then
        # DESIGN-001 (Toji v9.11.0 pre-release audit, MEDIUM): the checker is
        # DELIBERATELY dev-only (publish-manifest.yaml classifies it
        # completeness_dev_only) and never ships, while docs/DESIGN-DECISIONS.md
        # and this hook DO ship to every consumer install. The prior behavior
        # (hard `exit 1`, "reinstall via install-git-hooks") permanently
        # blocked any commit touching the file on a consumer install, with a
        # remediation that could never actually restore the missing checker
        # (the installer only copies this hook file, never the checker) --
        # trapping the operator with git commit --no-verify as the only
        # escape, which also disables every OTHER stage in this hook.
        # Fix: when the checker is genuinely absent, this is not a violation
        # to block on -- it is an environment where the check cannot run by
        # design. Skip loudly (never silently) and let the commit proceed, per
        # the standing rule "a control that cannot cover a path must say so
        # visibly, never silently" (CLAUDE.md). No new DZP_ALLOW_* override is
        # introduced here: there is no risk decision for an operator to
        # authorize per-commit, since the checker's absence is a deterministic,
        # by-design property of the install, not a choice made at commit time.
        # When the checker IS present (the canonical/dev repo), behavior below
        # is completely unchanged from before this fix -- still fail-closed.
        echo "[t19r-gate] NOT CHECKED: scripts/check_trigger19r_sanitization.py is not present in this install (dev-only tool, not shipped); docs/DESIGN-DECISIONS.md sanitization was NOT verified this commit." >&2
    else
        PYT=""
        if command -v python3 >/dev/null 2>&1; then PYT=python3
        elif command -v python >/dev/null 2>&1; then PYT=python
        fi
        if [ -z "$PYT" ]; then
            echo "[trigger19r-gate] COMMIT BLOCKED: no Python runtime — Trigger 19-R sanitization gate cannot run." >&2
            echo "  Fix: install Python 3. No override exists -- unstage the file to proceed." >&2
            exit 1
        fi
        T19R_TMP="$(mktemp)"
        # FINDING 1b (fix round 1): defensive guard even with --diff-filter=d
        # above -- belt-and-suspenders against any other reason the index
        # blob cannot be read (e.g. a corrupt index, a race with a
        # concurrent git operation). Without this guard, a failing `git show`
        # under `set -eu` aborts the ENTIRE hook script with a raw git fatal,
        # skipping every later stage AND leaking $T19R_TMP.
        git show :docs/DESIGN-DECISIONS.md > "$T19R_TMP" || {
            rm -f "$T19R_TMP"
            echo "[trigger19r-gate] COMMIT BLOCKED: cannot read staged docs/DESIGN-DECISIONS.md from the index." >&2
            exit 1
        }
        if ! "$PYT" "$T19R_CHECKER" --public "$T19R_TMP" --repo-root "$ROOT"; then
            rm -f "$T19R_TMP"
            echo "[trigger19r-gate] COMMIT BLOCKED: staged docs/DESIGN-DECISIONS.md failed sanitization." >&2
            exit 1
        fi
        rm -f "$T19R_TMP"
    fi
fi

exit 0
