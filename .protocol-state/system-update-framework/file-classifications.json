{
  "_metadata": {
    "document_type": "INTERNAL DOCUMENT",
    "classification": "INTERNAL",
    "description": "File Classification Registry - Enforces INTERNAL vs CORE file separation",
    "created": "2025-11-25T00:00:00Z",
    "last_updated": "2025-11-25T00:00:00Z",
    "framework_version": "1.0.0"
  },
  "classification_system": {
    "INTERNAL": {
      "description": "Sensitive operational data, planning documents, version logs, framework records",
      "markers": [
        "[INTERNAL DOCUMENT]",
        "[INTERNAL]"
      ],
      "git_policy": "NEVER_COMMIT",
      "actions_blocked": [
        "git add",
        "git stage",
        "git commit",
        "git push"
      ]
    },
    "CORE": {
      "description": "Production codebase intended for version control and public repository",
      "markers": [
        "[CORE FILE]",
        "[CORE]"
      ],
      "git_policy": "STANDARD_WORKFLOW",
      "requirements": [
        "version_verification",
        "backup_before_modify"
      ]
    }
  },
  "internal_directories": [
    ".protocol-state/system-update-framework/",
    ".protocol-state/backups/",
    ".protocol-state/research/**/*.raw.log",
    ".protocol-state/trigger-19.md",
    "notes/",
    "conversion/"
  ],
  "internal_patterns": [
    "*_INTERNAL.*",
    "*_ACTIONABLE.md",
    "*_REMEDIATION.md",
    "*_DRAFT.md",
    "*_WIP.md",
    "*_PROGRESS.md",
    "*_COMPLETE.md",
    "*_ACTION_PLAN.md",
    "*_DESIGN.md",
    "*_REVIEW.md",
    "SYSTEM_UPDATE_*.md",
    "P0_*.md",
    "P1_*.md",
