{
  "_metadata": {
    "document_type": "INTERNAL DOCUMENT",
    "classification": "INTERNAL",
    "description": "File Classification Registry - Enforces INTERNAL vs CORE file separation and update behavior",
    "created": "{{INSTALL_DATE}}",
    "last_updated": "{{INSTALL_DATE}}",
    "framework_version": "1.2.0",
    "template": true
  },
  "classification_system": {
    "INTERNAL": {
      "description": "Sensitive operational data, planning documents, version logs, framework records",
      "markers": ["[INTERNAL DOCUMENT]", "[INTERNAL]"],
      "git_policy": "NEVER_COMMIT",
      "actions_blocked": ["git add", "git stage", "git commit", "git push"]
    },
    "CORE": {
      "description": "Production codebase intended for version control and public repository",
      "markers": ["[CORE FILE]", "[CORE]"],
      "git_policy": "STANDARD_WORKFLOW",
      "requirements": ["version_verification", "backup_before_modify"]
    }
  },
  "update_classifications": {
    "protocol_core": {
      "description": "Protocol artifacts safe to overwrite from core-files archives during updates",
      "behavior": "OVERWRITE",
      "paths": [
        "protocol/CLAUDE.md",
        "protocol/*.agent.md",
        "protocol/modules/",
        "protocol/gojo-procedures/",
        "protocol/skills/",
        "protocol/HANDOFF_SPECIFICATION.md",
        "protocol/MASK_MODE.md",
        "protocol/MCP_INTEGRATION.md",
        "protocol/RESEARCH_MODE.md",
        "protocol/TIER-SELECTION-GUIDE.md",
        "protocol/EMERGENCY_STOP_STANDARD.md",
        "protocol/TECHNICAL_LEVEL_ADAPTATION.md",
        ".claude/commands/",
        ".dzp-killswitch/",
        "docs/",
        "Domain Zero Agents/",
        "Domain Zero Agents - Full JJK Edition/"
      ]
    },
    "project_state_protected": {
      "description": "Project-specific state files that must NEVER be overwritten during updates",
      "behavior": "NEVER_OVERWRITE",
      "protected_files": [
        ".protocol-state/dev-notes.md",
        ".protocol-state/security-review.md",
        ".protocol-state/trigger-19.md"
      ],
      "rationale": "Contains project-specific implementation logs, security findings, and private intelligence that would be lost if overwritten"
    },
    "project_state_merge": {
      "description": "Project-specific state files that require schema merge, not wholesale replacement",
      "behavior": "MERGE_ONLY",
      "merge_files": [".protocol-state/project-state.json"],
      "merge_algorithm": {
        "description": "Merge new schema fields while preserving project-specific data",
        "steps": [
          "1. Load local project-state.json",
          "2. Load template project-state.json from core-files archive",
          "3. Set protocol_version to new version",
          "4. For each new field in template missing locally: add with default value",
          "5. For existing fields: preserve project-specific values (name, description, dates, git info, mission status)",
          "6. Only update protocol-only fields (version, system_update_framework.version)",
          "7. Write merged JSON back to project-state.json"
        ],
        "on_failure": "Abort merge, log error, request manual intervention"
      }
    },
    "template_initializer": {
      "description": "Template files that initialize real files only when the target is missing",
      "behavior": "CONDITIONAL_COPY",
      "rule": {
        "if_md_exists": "KEEP existing file, ignore template",
        "if_md_missing": "Copy .template.md to .md"
      },
      "template_patterns": ["*.template.md", "*.template.json", "*.template.yaml"],
      "applies_to_directories": [".protocol-state/", "docs/"]
    }
  },
  "internal_directories": [
    ".protocol-state/system-update-framework/",
    ".protocol-state/backups/",
    ".protocol-state/research/**/*.raw.log",
    ".protocol-state/internal-docs/",
    "notes/",
    "conversion/"
  ],
  "internal_patterns": [
    "*_INTERNAL.*",
    "*_ACTIONABLE.md",
    "*_REMEDIATION.md",
    "*_DRAFT.md",
    "*_WIP.md",
    "*_PROGRESS.md",
    "*_COMPLETE.md",
    "*_ACTION_PLAN.md",
    "*_DESIGN.md",
    "*_REVIEW.md",
    "SYSTEM_UPDATE_*.md",
    "P0_*.md",
    "P1_*.md",
    "P2_*.md",
    "P3_*.md",
    "SESSION_SUMMARY_*.md",
    "RELEASE_NOTES_*.md"
  ],
  "core_directories": [
    "protocol/",
    "docs/",
    "scripts/",
    "release/",
    "Domain Zero Agents/",
    ".github/"
  ],
  "core_files": [
    "protocol/CLAUDE.md",
    "protocol/gojo.agent.md",
    "protocol/yuuji.agent.md",
    "protocol/megumi.agent.md",
    "protocol/nobara.agent.md",
    "protocol/sukuna.agent.md",
    "protocol/todo.agent.md",
    "protocol/maki.agent.md",
    "protocol/panda.agent.md",
    "protocol/inumaki.agent.md",
    "protocol.config.yaml",
    "README.md",
    "VERSION.md",
    "CHANGELOG.md",
    "PROTOCOL_QUICKSTART.md",
    "FAQ.md",
    "SECURITY.md",
    "LICENSE",
    "CODEOWNERS"
  ],
  "classification_rules": {
    "priority_order": [
      "1. Explicit header marker takes precedence",
      "2. Update classification (protocol_core/project_state_protected/project_state_merge/template_initializer)",
      "3. Directory-based classification",
      "4. Pattern-based classification",
      "5. Default to CORE if ambiguous (request clarification)"
    ],
    "enforcement": {
      "pre_git_check": true,
      "block_internal_staging": true,
      "require_classification_for_new_files": true,
      "warn_on_ambiguous": true,
      "enforce_update_classifications": true
    }
  },
  "installation_flows": {
    "fresh_install": {
      "description": "Installing DZP into a blank/new project with no existing state",
      "safe_operations": [
        "Copy entire protocol/ directory",
        "Copy entire .protocol-state/ template directory",
        "Initialize project-state.json from template, then customize"
      ],
      "requirements": [
        "No existing protocol/ directory",
        "No existing .protocol-state/ directory"
      ]
    },
    "in_place_upgrade": {
      "description": "Upgrading DZP in an existing project with existing state",
      "safe_operations": [
        "Sync protocol artifacts (protocol/, docs/, agents, slash commands, modules, gojo-procedures)",
        "Merge project-state.json fields (schema update only)"
      ],
      "forbidden_operations": [
        "Overwrite .protocol-state/dev-notes.md",
        "Overwrite .protocol-state/security-review.md",
        "Overwrite .protocol-state/trigger-19.md",
        "Copy .protocol-state/ templates over existing state wholesale"
      ],
      "pre_requisites": [
        "Backup ALL existing files including .protocol-state/",
        "Verify rollback capability"
      ]
    }
  },
  "verification_log": [],
  "blocked_operations_log": []
}
